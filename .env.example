# =============================================================================
# Provider API keys (just fill in the ones you need)
# =============================================================================
# OpenAI API Key
# Get your API key from: https://openai.com/api/
OPENAI_API_KEY=your_openai_api_key

# SambaNova API Keys
# Get your API keys from: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=your_sambanova_api_key

# Together API Key
# Get your API key from: https://together.ai/
TOGETHER_API_KEY=your_together_api_key

# Commonstack API Key
# Get your API key from: https://commonstack.ai/
COMMONSTACK_API_KEY=your_commonstack_api_key

# OpenRouter API key (required only when --api_provider openrouter is selected).
# Create your own key at https://openrouter.ai/keys; never commit it.
OPENROUTER_API_KEY=
# Optional OpenRouter application attribution headers.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
# Optional rotating default for the CLIs when openrouter is selected. Check the
# OpenRouter catalog before use; free-model availability is not permanent.
OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional retry/temperature tuning. Defaults are 5 retries, 1 second base delay, and 0.0.
ACE_MAX_RETRIES=5
ACE_RETRY_BASE_SECONDS=1
ACE_TEMPERATURE=0.0
